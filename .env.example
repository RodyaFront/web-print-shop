# Password for /admin (Nuxt runtimeConfig)
NUXT_ADMIN_PASSWORD=change-me

# Random string for signing the admin session cookie
NUXT_SESSION_SECRET=replace-with-a-long-random-string

# Public site origin (canonical, sitemap, JSON-LD). No trailing slash.
NUXT_PUBLIC_SITE_URL=https://example.com

# Delivery carriers (server-only; leave empty to hide that method in UI)
NUXT_NP_API_KEY=
NUXT_MEEST_LOGIN=
NUXT_MEEST_PASSWORD=
NUXT_UKRPOSHTA_BEARER=
